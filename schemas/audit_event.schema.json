{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit_event.schema.json",
  "title": "Audit event",
  "description": "One line of runs/<cid>/audit.jsonl. Only metadata: no message content, prompts or tool inputs.",
  "type": "object",
  "required": ["correlation_id", "seq", "step_id", "ts", "event"],
  "properties": {
    "correlation_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "seq": {"type": "integer", "minimum": 1},
    "step_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}:[1-9][0-9]*$"},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "event": {
      "enum": [
        "run_started",
        "llm_call",
        "tool_call",
        "dispatch_started",
        "dispatch_finished",
        "guardrail_rejected",
        "gate_opened",
        "run_finished",
        "decision_recorded"
      ]
    }
  },
  "if": {"properties": {"event": {"const": "llm_call"}}},
  "then": {"$ref": "#/$defs/llm_call"},
  "else": {"$ref": "#/$defs/envelope_only"},
  "$defs": {
    "envelope_only": {
      "properties": {"correlation_id": true, "seq": true, "step_id": true, "ts": true, "event": true},
      "additionalProperties": false
    },
    "tokens": {"type": "integer", "minimum": 0},
    "label": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
    "llm_call": {
      "required": [
        "parent_step_id",
        "agent",
        "workflow",
        "step",
        "requested_model",
        "served_model",
        "fallback_ran",
        "effort",
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "cost_usd",
        "pricing_missing",
        "stop_reason",
        "latency_ms",
        "error"
      ],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "parent_step_id": {"anyOf": [{"$ref": "#/properties/step_id"}, {"type": "null"}]},
        "agent": {"$ref": "#/$defs/label"},
        "workflow": {"anyOf": [{"$ref": "#/$defs/label"}, {"type": "null"}]},
        "step": {"anyOf": [{"$ref": "#/$defs/label"}, {"type": "null"}]},
        "requested_model": {"$ref": "#/$defs/label"},
        "served_model": {"type": ["string", "null"]},
        "fallback_ran": {"type": "boolean"},
        "effort": {"$ref": "#/$defs/label"},
        "input_tokens": {"$ref": "#/$defs/tokens"},
        "output_tokens": {"$ref": "#/$defs/tokens"},
        "cache_creation_input_tokens": {"$ref": "#/$defs/tokens"},
        "cache_read_input_tokens": {"$ref": "#/$defs/tokens"},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "pricing_missing": {"type": "boolean"},
        "stop_reason": {"type": ["string", "null"]},
        "latency_ms": {"type": "integer", "minimum": 0},
        "error": {"type": ["string", "null"]}
      },
      "additionalProperties": false,
      "if": {"properties": {"pricing_missing": {"const": true}}},
      "then": {"properties": {"cost_usd": {"type": "null"}}},
      "else": {"properties": {"cost_usd": {"type": "number"}}}
    }
  }
}
