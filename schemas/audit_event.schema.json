{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit_event.schema.json",
  "title": "Audit event",
  "description": "One line of runs/<cid>/audit.jsonl. Only metadata: no message content, prompts or tool inputs.",
  "type": "object",
  "required": ["correlation_id", "seq", "step_id", "ts", "event"],
  "properties": {
    "correlation_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"},
    "seq": {"type": "integer", "minimum": 1},
    "step_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}:[1-9][0-9]*$"},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "event": {
      "enum": [
        "run_started",
        "llm_call",
        "tool_call",
        "dispatch_started",
        "dispatch_finished",
        "guardrail_rejected",
        "gate_opened",
        "run_finished",
        "decision_recorded"
      ]
    }
  },
  "if": {"properties": {"event": {"const": "llm_call"}}},
  "then": {"$ref": "#/$defs/llm_call"},
  "else": {
    "if": {"properties": {"event": {"const": "tool_call"}}},
    "then": {"$ref": "#/$defs/tool_call"},
    "else": {
      "if": {"properties": {"event": {"const": "guardrail_rejected"}}},
      "then": {"$ref": "#/$defs/guardrail_rejected"},
      "else": {
        "if": {"properties": {"event": {"const": "dispatch_started"}}},
        "then": {"$ref": "#/$defs/dispatch_started"},
        "else": {
          "if": {"properties": {"event": {"const": "dispatch_finished"}}},
          "then": {"$ref": "#/$defs/dispatch_finished"},
          "else": {
            "if": {"properties": {"event": {"const": "gate_opened"}}},
            "then": {"$ref": "#/$defs/gate_opened"},
            "else": {
              "if": {"properties": {"event": {"const": "run_finished"}}},
              "then": {"$ref": "#/$defs/run_finished"},
              "else": {
                "if": {"properties": {"event": {"const": "decision_recorded"}}},
                "then": {"$ref": "#/$defs/decision_recorded"},
                "else": {"$ref": "#/$defs/envelope_only"}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "envelope_only": {
      "properties": {"correlation_id": true, "seq": true, "step_id": true, "ts": true, "event": true},
      "additionalProperties": false
    },
    "tokens": {"type": "integer", "minimum": 0},
    "label": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
    "optional_label": {"anyOf": [{"$ref": "#/$defs/label"}, {"type": "null"}]},
    "parent_step_id": {"anyOf": [{"$ref": "#/properties/step_id"}, {"type": "null"}]},
    "target_id": {"type": "string", "pattern": "^(EX-[A-Z]{2,8}-v[1-9][0-9]*|DR-v[1-9][0-9]*)$"},
    "output_id": {"type": "string", "pattern": "^(EX-[A-Z]{2,8}-v[1-9][0-9]*|RV-[1-9][0-9]*|DR-v[1-9][0-9]*)$"},
    "dispatch_started": {
      "$comment": "Every line of the invocation carries this line's step_id as its parent_step_id.",
      "required": ["agent", "workflow", "step", "target_id"],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "agent": {"$ref": "#/$defs/label"},
        "workflow": {"$ref": "#/$defs/optional_label"},
        "step": {"$ref": "#/$defs/optional_label"},
        "target_id": {"anyOf": [{"$ref": "#/$defs/target_id"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "dispatch_finished": {
      "$comment": "output_id names the accepted output; code is the DispatchError of a dispatch that produced none.",
      "required": ["parent_step_id", "agent", "workflow", "step", "output_id", "code"],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "parent_step_id": {"$ref": "#/properties/step_id"},
        "agent": {"$ref": "#/$defs/label"},
        "workflow": {"$ref": "#/$defs/optional_label"},
        "step": {"$ref": "#/$defs/optional_label"},
        "output_id": {"anyOf": [{"$ref": "#/$defs/output_id"}, {"type": "null"}]},
        "code": {
          "enum": [
            "SCHEMA_INVALID",
            "EVIDENCE_INVALID",
            "PRECONDITION_FAILED",
            "UNKNOWN_TARGET",
            "RETRY_CAP_REACHED",
            "TOOL_LOOP_LIMIT",
            "REFUSAL",
            "MAX_TOKENS",
            "API_ERROR",
            null
          ]
        }
      },
      "additionalProperties": false,
      "if": {"properties": {"code": {"const": null}}},
      "then": {"properties": {"output_id": {"type": "string"}}},
      "else": {"properties": {"output_id": {"const": null}}}
    },
    "subject": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "gate_opened": {
      "$comment": "subjects are harness-assigned: examination or draft IDs, <workflow>.<step> keys or workflow names.",
      "required": ["gate", "subjects"],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "gate": {"enum": ["SUBSTANCE_ELEVATION", "OPEN_CRITICAL_CHALLENGE", "COORDINATOR_ESCALATION"]},
        "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}}
      },
      "additionalProperties": false
    },
    "run_finished": {
      "$comment": "halt_reason is set exactly when the status is halted.",
      "required": ["status", "halt_reason"],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "status": {"enum": ["finalized", "pending_human", "halted"]},
        "halt_reason": {
          "enum": [
            "COORDINATOR_TURN_LIMIT",
            "COORDINATOR_REFUSAL",
            "COORDINATOR_MAX_TOKENS",
            "COORDINATOR_API_ERROR",
            "NO_REPORT",
            "REPORT_NOT_REVIEWED",
            null
          ]
        }
      },
      "additionalProperties": false,
      "if": {"properties": {"status": {"const": "halted"}}},
      "then": {"properties": {"halt_reason": {"type": "string"}}},
      "else": {"properties": {"halt_reason": {"const": null}}}
    },
    "decision_recorded": {
      "$comment": "The note stays out of the audit; decisions.jsonl holds it.",
      "required": ["decision", "reviewer", "gates_resolved", "report_sha256"],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "decision": {"enum": ["continue", "reject"]},
        "reviewer": {"type": "string", "minLength": 1},
        "gates_resolved": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["SUBSTANCE_ELEVATION", "OPEN_CRITICAL_CHALLENGE", "COORDINATOR_ESCALATION"]}
        },
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "tool_call": {
      "$comment": "tool is null for a name outside the sub-agent tools, so model-written text never reaches the audit.",
      "required": ["parent_step_id", "agent", "workflow", "step", "tool", "allowed", "is_error"],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "parent_step_id": {"$ref": "#/$defs/parent_step_id"},
        "agent": {"$ref": "#/$defs/label"},
        "workflow": {"$ref": "#/$defs/optional_label"},
        "step": {"$ref": "#/$defs/optional_label"},
        "tool": {"enum": ["list_files", "read_file", "list_manifests", "read_manifest", "query_osv", null]},
        "allowed": {"type": "boolean"},
        "is_error": {"type": "boolean"}
      },
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"tool": {"const": null}}}, "then": {"properties": {"allowed": {"const": false}}}},
        {"if": {"properties": {"allowed": {"const": false}}}, "then": {"properties": {"is_error": {"const": true}}}}
      ]
    },
    "guardrail_rejected": {
      "required": ["parent_step_id", "agent", "workflow", "step", "code", "problems"],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "parent_step_id": {"$ref": "#/$defs/parent_step_id"},
        "agent": {"$ref": "#/$defs/label"},
        "workflow": {"$ref": "#/$defs/optional_label"},
        "step": {"$ref": "#/$defs/optional_label"},
        "code": {
          "enum": [
            "SCHEMA_INVALID",
            "EVIDENCE_INVALID",
            "PRECONDITION_FAILED",
            "UNKNOWN_TARGET",
            "RETRY_CAP_REACHED",
            "TOOL_LOOP_LIMIT",
            "REFUSAL",
            "MAX_TOKENS",
            "API_ERROR"
          ]
        },
        "problems": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "llm_call": {
      "required": [
        "parent_step_id",
        "agent",
        "workflow",
        "step",
        "requested_model",
        "served_model",
        "fallback_ran",
        "effort",
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "cost_usd",
        "pricing_missing",
        "stop_reason",
        "latency_ms",
        "error"
      ],
      "properties": {
        "correlation_id": true,
        "seq": true,
        "step_id": true,
        "ts": true,
        "event": true,
        "parent_step_id": {"$ref": "#/$defs/parent_step_id"},
        "agent": {"$ref": "#/$defs/label"},
        "workflow": {"$ref": "#/$defs/optional_label"},
        "step": {"$ref": "#/$defs/optional_label"},
        "requested_model": {"$ref": "#/$defs/label"},
        "served_model": {"type": ["string", "null"]},
        "fallback_ran": {"type": "boolean"},
        "effort": {"$ref": "#/$defs/label"},
        "input_tokens": {"$ref": "#/$defs/tokens"},
        "output_tokens": {"$ref": "#/$defs/tokens"},
        "cache_creation_input_tokens": {"$ref": "#/$defs/tokens"},
        "cache_read_input_tokens": {"$ref": "#/$defs/tokens"},
        "cost_usd": {"type": ["number", "null"], "minimum": 0},
        "pricing_missing": {"type": "boolean"},
        "stop_reason": {"type": ["string", "null"]},
        "latency_ms": {"type": "integer", "minimum": 0},
        "error": {"type": ["string", "null"]}
      },
      "additionalProperties": false,
      "if": {"properties": {"pricing_missing": {"const": true}}},
      "then": {"properties": {"cost_usd": {"type": "null"}}},
      "else": {"properties": {"cost_usd": {"type": "number"}}}
    }
  }
}
