{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eval_history.schema.json",
  "title": "Eval history line",
  "description": "One line of evals/results/history.jsonl: one agent's execution. Scores, hashes, totals and a note.",
  "type": "object",
  "required": [
    "agent",
    "generated_at",
    "runs",
    "model",
    "effort",
    "prompt_sha256",
    "skills_sha256",
    "judge_prompt_sha256",
    "all_passed",
    "summary",
    "total_cost_usd",
    "note"
  ],
  "properties": {
    "agent": {"$ref": "#/$defs/single_line", "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "generated_at": {
      "$ref": "#/$defs/single_line",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "runs": {"type": "integer", "minimum": 1},
    "model": {"$ref": "#/$defs/single_line", "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
    "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "skills_sha256": {"$ref": "#/$defs/sha256"},
    "judge_prompt_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "all_passed": {"type": "boolean"},
    "summary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "comparison", "threshold", "per_run_mean", "passed_all_runs"],
        "properties": {
          "criterion": {"$ref": "#/$defs/single_line", "type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "comparison": {"enum": ["at_least", "at_most"]},
          "threshold": {"type": "number"},
          "per_run_mean": {"type": "array", "minItems": 1, "items": {"type": "number"}},
          "passed_all_runs": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "total_cost_usd": {"type": ["number", "null"], "minimum": 0},
    "note": {"$ref": "#/$defs/no_line_break", "type": "string", "maxLength": 500}
  },
  "additionalProperties": false,
  "$defs": {
    "single_line": {
      "$comment": "jsonschema matches pattern with Python re.search, whose $ also matches before a trailing newline.",
      "not": {"pattern": "\\n"}
    },
    "no_line_break": {
      "$comment": "Every character str.splitlines() splits on, so a note that passes is one line.",
      "not": {"pattern": "[\\n\\r\\u000b\\u000c\\u001c\\u001d\\u001e\\u0085\\u2028\\u2029]"}
    },
    "sha256": {"$ref": "#/$defs/single_line", "type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
